# =================================================
# AUTOFY BACKEND PRODUCTION ENVIRONMENT VARIABLES
# =================================================

PROJECT_NAME=Autofy Backend
ENVIRONMENT=production
DEBUG=false
PORT=8000

# PostgreSQL Connection String (Render / Supabase / Neon / AWS RDS)
DATABASE_URL=postgresql://username:password@hostname:5432/databasename

# Cryptographic JWT Signing Key (Must be at least 32 characters in production)
JWT_SECRET_KEY=YOUR_PRODUCTION_32_CHAR_JWT_SECRET_KEY

# CORS Allowed Origins (Comma-separated list)
CORS_ORIGINS=["https://autofy11.netlify.app","http://localhost:3000"]

# SPA Frontend Public URL
FRONTEND_URL=https://autofy11.netlify.app

# Google OAuth Credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://your-backend-api.onrender.com/api/v1/auth/google/callback

# Meta WhatsApp Cloud API Credentials
WHATSAPP_TOKEN=YOUR_META_WHATSAPP_PERMANENT_ACCESS_TOKEN
WHATSAPP_PHONE_ID=YOUR_META_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=YOUR_CUSTOM_WEBHOOK_VERIFICATION_TOKEN

# Cognitive AI Layer
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY

# Razorpay Payment Gateway Credentials (ON HOLD for Phase 3 activation)
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=hello@autofy.io
