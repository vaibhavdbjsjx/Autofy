# ═══════════════════════════════════════════════════════════
# FRONTEND (Vite — variables must be prefixed with VITE_)
# ═══════════════════════════════════════════════════════════

# ─── API connection ─────────────────────────────────────
# Leave VITE_API_URL empty in dev: requests stay relative and the Vite proxy
# forwards /api → the backend. Set it to your API origin in production.
VITE_API_URL=
# Where the dev proxy sends /api (defaults to http://localhost:8000).
VITE_API_PROXY_TARGET=http://localhost:8000

# ─── Supabase (Required for sign in / sign up) ──────────
# Project Settings > API in your Supabase dashboard (https://supabase.com/dashboard).
# Without these, the frontend runs in "mock mode" and real auth is disabled.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ─── Google Gemini AI (Required for AI features) ────────
# Get from https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ─── Razorpay (Optional — for Indian payments) ──────────
# Get from https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# ─── Stripe (Optional — for international payments) ─────
# Get from https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here


# ═══════════════════════════════════════════════════════════
# BACKEND (FastAPI — read from backend/.env via pydantic-settings)
# ═══════════════════════════════════════════════════════════

# ─── Database & JWT (Required for auth) ─────────────────
# Backend defaults to a local SQLite file (sqlite:///./autofy.db) with zero setup.
# For production, uncomment the Postgres line and point it at your instance.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autofy
DATABASE_URL=sqlite:///./autofy.db
JWT_SECRET_KEY=change_me_to_a_long_random_secret
# Where the SPA runs — the Google OAuth callback redirects the browser back here.
FRONTEND_URL=http://localhost:3000

# ─── Google Gemini AI (Required — backend AI replies) ───
# Same key as the frontend one above. Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Razorpay (Required for payments) ───────────────────
# Get keys from https://dashboard.razorpay.com/app/keys
# WEBHOOK_SECRET is set when you create a webhook in the Razorpay dashboard.
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ─── Meta WhatsApp Cloud API (Required for WhatsApp) ────
# From Meta Business Suite > WhatsApp > API Setup (https://business.facebook.com).
# WHATSAPP_TOKEN = permanent access token, WHATSAPP_PHONE_ID = phone number ID.
# WHATSAPP_VERIFY_TOKEN is any secret string you also paste into the Meta webhook config.
WHATSAPP_TOKEN=your_whatsapp_permanent_access_token_here
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=autofy_webhook_verification_token_2026

# ─── Google OAuth (Optional — enables "Continue with Google") ─
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ─── SMTP Server Configuration (Required for Email) ────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password-here
SMTP_FROM_EMAIL=hello@autofy.io
